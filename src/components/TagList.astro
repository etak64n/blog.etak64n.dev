---
import { tagPath } from '../lib/posts.ts';
import { TAGS, type TagSlug } from '../tags.ts';

interface Props {
  tags: readonly TagSlug[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <p class="tax">
      {tags.map((tag) => (
        <a class="pill tag" href={tagPath(tag)}>
          #{TAGS[tag]}
        </a>
      ))}
    </p>
  )
}
