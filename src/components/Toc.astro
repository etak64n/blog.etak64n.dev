---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

interface Section {
  heading: MarkdownHeading;
  subsections: MarkdownHeading[];
}

// h2 and h3 only; `footnote-label` is the hidden heading of the footnotes.
const headings = Astro.props.headings.filter(
  ({ depth, slug }) => (depth === 2 || depth === 3) && slug !== 'footnote-label',
);

const sections: Section[] = [];
for (const heading of headings) {
  const parent = sections.at(-1);
  if (heading.depth === 3 && parent) parent.subsections.push(heading);
  else sections.push({ heading, subsections: [] });
}
---

{
  headings.length >= 2 && (
    <>
      <details class="toc" id="toc" open>
        <summary>目次</summary>
        <ol>
          {sections.map(({ heading, subsections }) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
              {subsections.length > 0 && (
                <ol>
                  {subsections.map((subsection) => (
                    <li>
                      <a href={`#${subsection.slug}`}>{subsection.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
      {/* Closed above the article on narrow screens; decided before the first paint. */}
      <script is:inline>
        if (!matchMedia('(min-width: 1264px)').matches) document.getElementById('toc').open = false;
      </script>
    </>
  )
}

<script>
  // Highlights the section being read and keeps the side contents open on wide screens.
  const toc = document.querySelector<HTMLDetailsElement>('#toc');

  if (toc) {
    const wide = window.matchMedia('(min-width: 1264px)');
    wide.addEventListener('change', () => {
      if (wide.matches) toc.open = true;
    });

    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    let frame = 0;

    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.25;
      let current = -1;
      targets.forEach((target, index) => {
        if (target && target.getBoundingClientRect().top <= line) current = index;
      });
      links.forEach((link, index) => {
        if (index === current) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>
