---
import MagazineGrid from "../components/MagazineGrid.astro";
import PostRows from "../components/PostRows.astro";
import Base from "../layouts/Base.astro";
import { getMagazines } from "../lib/magazines";
import { getLatestPosts } from "../lib/posts";
import { HOME_MAGAZINES, HOME_POSTS } from "../site";

const [{ magazines, cacheHint: magazinesHint }, { posts, cacheHint }] = await Promise.all([
	getMagazines(HOME_MAGAZINES),
	getLatestPosts(HOME_POSTS),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(magazinesHint);
	Astro.cache.set(cacheHint);
}
---

<Base>
	<section class="home-section">
		<h2 class="section-title">最新記事</h2>
		{
			posts.length > 0 ? (
				<>
					<PostRows posts={posts} />
					<p class="home-more">
						<a href="/articles/">記事一覧 →</a>
					</p>
				</>
			) : (
				<p class="empty-state">まだ記事がありません。</p>
			)
		}
	</section>
	{
		magazines.length > 0 && (
			<section class="home-section">
				<h2 class="section-title">マガジン</h2>
				<MagazineGrid magazines={magazines} cover="beside" />
			</section>
		)
	}
</Base>
