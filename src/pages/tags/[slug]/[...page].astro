---
// /tags/<slug>/ and its later pages, /tags/<slug>/page/<n>/.
import { decodeSlug } from "emdash";
import Pagination from "../../../components/Pagination.astro";
import PostGrid from "../../../components/PostGrid.astro";
import Base from "../../../layouts/Base.astro";
import { getPostsPage, postTags, readPageNumber, tagPath } from "../../../lib/posts";

const slug = decodeSlug(Astro.params.slug);
const rest = Astro.params.page;
const page = rest === undefined ? 1 : readPageNumber(/^page\/([^/]+)$/.exec(rest)?.[1]);
if (!slug || page === null) return Astro.rewrite("/404");

const { posts, cacheHint, hasMore } = await getPostsPage(page, slug);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// A tag has a page while a published post carries it.
const tag = posts.length > 0 ? postTags(posts[0]).find((item) => item.slug === slug) : undefined;
if (!tag) return Astro.rewrite("/404");
---

<Base title={page === 1 ? tag.label : `${tag.label}（${page} ページ目）`}>
	<h1>{tag.label}</h1>
	<PostGrid posts={posts} />
	<Pagination base={tagPath(tag.slug)} current={page} hasMore={hasMore} />
</Base>
