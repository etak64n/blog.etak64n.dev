---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import { postPath, type Post } from '../lib/posts.ts';

interface Props {
  posts: Post[];
  /** Level of the post titles, below the heading of the section the list is in. */
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <Heading class="post-item-title">
          <a href={postPath(post.id)}>{post.data.title}</a>
        </Heading>
        <div class="post-meta">
          <FormattedDate date={post.data.date} />
          {post.data.updated && (
            <span>
              更新 <FormattedDate date={post.data.updated} />
            </span>
          )}
          {post.data.draft && <span class="badge">下書き</span>}
        </div>
        {post.data.description && <p class="post-item-description">{post.data.description}</p>}
        <TagList tags={post.data.tags} />
      </li>
    ))
  }
</ul>
