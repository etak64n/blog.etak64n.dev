---
import PostGrid from "../components/PostGrid.astro";
import Base from "../layouts/Base.astro";
import { getLatestPosts } from "../lib/posts";
import { HOME_POSTS } from "../site";

const { posts, cacheHint } = await getLatestPosts(HOME_POSTS);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base>
	<h1>最新記事</h1>
	{posts.length > 0 ? <PostGrid posts={posts} /> : <p class="empty-state">まだ記事がありません。</p>}
</Base>
