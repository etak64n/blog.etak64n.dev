{
  // Run from the Command Palette: "Tasks: Run Task".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "記事を作成",
      "detail": "src/content/blog/<slug>/<slug>.md を下書きとして作り、開く",
      "type": "shell",
      "command": "npm run new -- \"${input:slug}\" --open",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "close": true }
    },
    {
      "label": "プレビュー（開発サーバー）",
      "detail": "http://localhost:4321/ で下書きを含めて表示する",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "slug",
      "type": "promptString",
      "description": "記事の slug（URL とファイル名になる。半角英小文字・数字・ハイフン。例: cloudflare-workers-architecture）"
    }
  ]
}
