    "@codemirror/view": "^6.43.15",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@jsquash/webp": "^1.5.0",
    "@lezer/common": "^1.5.5",
    "@lezer/markdown": "^1.8.1",
    "astro": "^7.3.6",
    "astro-expressive-code": "^0.44.2",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
