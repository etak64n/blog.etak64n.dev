---
import Base from "../../layouts/Base.astro";
import { getUsedTags, tagPath } from "../../lib/posts";

// Tags on published posts, with their counts, in the order of their slugs.
const tags = await getUsedTags();
---

<Base title="Tags">
	<h1>Tags</h1>
	{
		tags.length > 0 ? (
			<ul class="taxonomy-list">
				{tags.map((tag) => (
					<li class="taxonomy-item">
						<a href={tagPath(tag.slug)}>{tag.label}</a>
						<span class="taxonomy-count">({tag.count})</span>
					</li>
				))}
			</ul>
		) : (
			<p class="empty-state">まだタグがありません。</p>
		)
	}
</Base>
